[user]
	name = Prashant Deva
	email = prashant@astradot.com
[core]
	excludesfile = ~/.gitignore_global

[diff]
        tool = difftastic

[difftool]
        prompt = false

[difftool "difftastic"]
        cmd = difft "$LOCAL" "$REMOTE"

[pager]
	difftool = false
	branch = false

# `git dft` is less to type than `git difftool`.
[alias]
        dft = difftool
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
